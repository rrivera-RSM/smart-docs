SMARTDOCS_BIND_ADDRESS=0.0.0.0
SMARTDOCS_WEB_PORT=3050
SMARTDOCS_API_BIND_ADDRESS=127.0.0.1
SMARTDOCS_API_PORT=8050
SMARTDOCS_ALLOWED_ORIGINS=http://127.0.0.1:3050,http://localhost:3050

# Azure AD / Microsoft Entra ID.
SMARTDOCS_AUTH_ENABLED=true
SMARTDOCS_AZURE_TENANT_ID=
SMARTDOCS_AZURE_WEB_CLIENT_ID=
SMARTDOCS_AZURE_WEB_CLIENT_SECRET=
SMARTDOCS_AZURE_API_CLIENT_ID=
NEXTAUTH_SECRET=
# Déjala vacía en desarrollo para que scripts/dev.sh use el puerto elegido.
NEXTAUTH_URL=

SMARTDOCS_NER_MODE=required
SMARTDOCS_NER_MODEL_PATH=.models/roberta-base-bne-capitel-ner-plus
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
SMARTDOCS_FEATURE_PDF=false
SMARTDOCS_FEATURE_IMAGE_OCR=false
SMARTDOCS_FEATURE_WEBADMIN=false

# Imputación de gastos: reutiliza la autenticación y API de SmartDocs.
FINANCE_IMPUTER_TOLERANCE_PERCENTAGE=0.10
# Opcional: ruta persistente alternativa para perfiles creados desde la interfaz.
# FINANCE_IMPUTER_PROVIDER_DIR=data/finance/providers
