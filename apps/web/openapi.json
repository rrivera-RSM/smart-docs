            "type": "array",
            "title": "Blocks"
          },
          "coverage_issues": {
            "items": {
              "$ref": "#/components/schemas/CoverageIssueResponse"
            },
            "type": "array",
            "title": "Coverage Issues"
          },
          "summary": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Summary"
          },
          "applied_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Applied Count"
          },
          "remaining_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remaining Count"
          },
          "download_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Download Url"
          },
          "output_filename": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Filename"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "filename",
          "document_format",
          "status",
          "progress",
          "error",
          "expires_in_minutes",
          "limitations",
          "findings",
          "groups",
          "blocks",
          "coverage_issues",
          "summary"
        ],
        "title": "AnonymizerJobResponse"
      },
      "ApplyRequest": {
        "properties": {
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/GroupDecision"
            },
            "type": "array",
            "minItems": 1,
            "title": "Decisions"
          },
          "review_confirmed": {
            "type": "boolean",
            "title": "Review Confirmed",
            "default": false
          },
          "remove_unsupported_content": {
            "type": "boolean",
            "title": "Remove Unsupported Content",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "decisions"
