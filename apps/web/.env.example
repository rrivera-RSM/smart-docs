# URL canónica opcional para metadatos Open Graph en despliegues internos.
NEXT_PUBLIC_APP_URL=

# Destino interno del proxy autenticado de Next.js.
SMARTDOCS_API_PROXY_TARGET=http://127.0.0.1:8050

# Azure AD / Microsoft Entra ID.
SMARTDOCS_AUTH_ENABLED=true
SMARTDOCS_AZURE_TENANT_ID=
SMARTDOCS_AZURE_WEB_CLIENT_ID=
SMARTDOCS_AZURE_WEB_CLIENT_SECRET=
SMARTDOCS_AZURE_API_CLIENT_ID=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://127.0.0.1:3050

# Funcionalidades de fase 2. Permanecen desactivadas en el despliegue inicial.
SMARTDOCS_FEATURE_PDF=false
SMARTDOCS_FEATURE_IMAGE_OCR=false
SMARTDOCS_FEATURE_WEBADMIN=false
