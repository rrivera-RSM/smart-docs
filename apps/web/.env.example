# URL pública opcional. Déjala vacía en local para usar el proxy de Next.js.
NEXT_PUBLIC_API_URL=

# URL canónica opcional para metadatos Open Graph en despliegues internos.
NEXT_PUBLIC_APP_URL=

# Destino interno utilizado por los rewrites de Next.js.
SMARTDOCS_API_PROXY_TARGET=http://127.0.0.1:8050

# Funcionalidades de fase 2. Permanecen desactivadas en el despliegue inicial.
SMARTDOCS_FEATURE_PDF=false
SMARTDOCS_FEATURE_IMAGE_OCR=false
SMARTDOCS_FEATURE_WEBADMIN=false
