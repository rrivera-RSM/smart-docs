{
  "name": "smartdocs-web",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "generate:api-types": "cd ../.. && SMARTDOCS_NER_MODE=rules PYTHONPATH=src:. .venv/bin/python scripts/export_openapi.py apps/web/openapi.json && cd apps/web && openapi-typescript openapi.json -o src/features/anonymizer/openapi.generated.ts"
  },
  "dependencies": {
    "lucide-react": "^0.563.0",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "brace-expansion": "5.0.9"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
